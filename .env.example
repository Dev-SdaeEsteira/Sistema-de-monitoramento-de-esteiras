# =========================================================================
# SDAE — Configuração de Banco de Dados Compartilhado (.env)
# =========================================================================
# Copie este arquivo para ".env" na raiz do projeto (o ".env" já está no
# .gitignore para nunca vazar senhas no GitHub).
#
# O Spring Boot carrega automaticamente o arquivo ".env" ao iniciar!
#
# POR QUE USAR ISSO?
#   Se cada computador usar "localhost:3306", cada PC salva usuários,
#   esteiras e leituras no seu próprio MySQL local (por isso um usuário
#   cadastrado no PC 1 não aparece no PC 2).
#   Apontando todos os PCs para o MESMO banco (na nuvem ou na rede local),
#   todos os usuários e dados ficam sincronizados automaticamente!
# =========================================================================

# OPÇÃO 1 (Recomendado para equipe em PCs diferentes): MySQL na Nuvem
# Ex.: Aiven (gratuito), Railway, TiDB Cloud, etc.
# SPRING_DATASOURCE_URL=jdbc:mysql://SEU-HOST-NUVEM:PORTA/sdae?createDatabaseIfNotExist=true&useSSL=true&requireSSL=true&serverTimezone=America/Sao_Paulo
# SPRING_DATASOURCE_USERNAME=seu_usuario_nuvem
# SPRING_DATASOURCE_PASSWORD=sua_senha_nuvem

# OPÇÃO 2 (Mesma rede Wi-Fi / laboratório): MySQL rodando no PC servidor
# SPRING_DATASOURCE_URL=jdbc:mysql://192.168.0.105:3306/sdae?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=America/Sao_Paulo
# SPRING_DATASOURCE_USERNAME=sdae_user
# SPRING_DATASOURCE_PASSWORD=sua_senha_aqui

# OPÇÃO 3 (Padrão local): MySQL instalado neste computador
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/sdae?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=America/Sao_Paulo
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=Senai@499
